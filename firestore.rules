    function isValidApprovalRecord(data) {
      return data.keys().hasAll(['approvalId', 'schoolId', 'targetType', 'targetId', 'targetTitle', 'submittedBy', 'reviewedBy', 'status', 'reviewerComment', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['approvalId', 'schoolId', 'targetType', 'targetId', 'targetTitle', 'submittedBy', 'reviewedBy', 'status', 'reviewerComment', 'createdAt', 'updatedAt']) &&
