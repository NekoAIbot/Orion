    function isValidLearningAchievement(data) {
      return data.keys().hasAll(['achievementId', 'studentId', 'title', 'criteriaDemonstrated', 'skillTag', 'createdAt']) &&
        data.keys().hasOnly(['achievementId', 'studentId', 'schoolId', 'title', 'criteriaDemonstrated', 'skillTag', 'createdAt']) &&
        data.achievementId is string && data.achievementId.size() >= 1 && data.achievementId.size() <= 128 && data.achievementId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 && data.studentId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.studentId == request.auth.uid &&
        (!('schoolId' in data) || (data.schoolId is string && data.schoolId.size() >= 1 && data.schoolId.size() <= 128)) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
        data.criteriaDemonstrated is string && data.criteriaDemonstrated.size() >= 2 && data.criteriaDemonstrated.size() <= 500 &&
        data.skillTag is string && data.skillTag.size() >= 2 && data.skillTag.size() <= 120 &&
        data.createdAt is timestamp;
    }

    // 1. Explicitly Provisioned Platform Admins Collection (Audit-Locked; School Admins & Ordinary Users Denied)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if false;
      allow create: if isAdmin() && isValidId(adminId) && isValidAdmin(incoming()) &&
        incoming().adminId == adminId &&
        incoming().status == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(adminId) && isValidAdmin(incoming()) &&
        incoming().adminId == existing().adminId &&
        incoming().email == existing().email &&
        incoming().role == existing().role &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'provisionedBy', 'provisioningMethod', 'updatedAt']);
      allow delete: if false;
    }

    // 2. Users Collection (PII Isolated to Owner or Admin; Self-Role Escalation Strictly Blocked)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && existing().uid == request.auth.uid;
      allow create: if isVerified() && isValidId(userId) && userId == request.auth.uid &&
        isValidUser(incoming()) &&
        (incoming().role == 'student' || incoming().role == 'independent_learner' || isAdmin()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() || (
          userId == request.auth.uid &&
          incoming().uid == existing().uid &&
          incoming().email == existing().email &&
          incoming().role == existing().role &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'educationLevel', 'selectedClass', 'updatedAt'])
        )
      );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // 3. Roles Collection
    match /roles/{roleId} {
      allow get: if isSignedIn() && isValidId(roleId);
      allow list: if false;
      allow create: if isAdmin() && isValidId(roleId) && isValidRolePermission(incoming()) && incoming().createdAt == request.time;
      allow update, delete: if isAdmin() && isValidId(roleId);
    }

    // 4. Schools Collection (Cross-School Isolation Enforced)
    match /schools/{schoolId} {
      allow get: if isSignedIn() && isValidId(schoolId) && (
        existing().ownerId == request.auth.uid ||
        isSchoolStudentOrStaff(schoolId) ||
        isAdmin()
      );
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(schoolId) && isValidSchool(incoming()) &&
        incoming().schoolId == schoolId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(schoolId) && isValidSchool(incoming()) && (
        isAdmin() || (
          (existing().ownerId == request.auth.uid || hasSchoolRole(schoolId, 'school_admin')) &&
          incoming().schoolId == existing().schoolId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
