        data.reviewedBy is string && data.reviewedBy.size() >= 1 && data.reviewedBy.size() <= 128 && data.reviewedBy.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.reviewedBy == request.auth.uid &&
