    function isValidStudentProject(data) {
      return data.keys().hasAll(['projectId', 'studentId', 'className', 'subject', 'title', 'practicalSkillFocus', 'reflectionNotes', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['projectId', 'studentId', 'schoolId', 'className', 'subject', 'title', 'practicalSkillFocus', 'reflectionNotes', 'status', 'createdAt', 'updatedAt']) &&
        data.projectId is string && data.projectId.size() >= 1 && data.projectId.size() <= 128 && data.projectId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 && data.studentId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.studentId == request.auth.uid &&
        (!('schoolId' in data) || (data.schoolId is string && data.schoolId.size() >= 1 && data.schoolId.size() <= 128)) &&
        data.className is string && data.className.size() >= 1 && data.className.size() <= 32 &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 100 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 200 &&
        data.practicalSkillFocus is string && data.practicalSkillFocus.size() >= 2 && data.practicalSkillFocus.size() <= 300 &&
        data.reflectionNotes is string && data.reflectionNotes.size() >= 2 && data.reflectionNotes.size() <= 2000 &&
        data.status is string && data.status.size() <= 32 && (
          data.status == 'in_progress' ||
          data.status == 'submitted' ||
          data.status == 'evaluated'
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
