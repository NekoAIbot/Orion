rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Platform Administrator Authorization:
    // Primary mechanism: Explicitly provisioned active record in /admins/{uid} or verified Firebase custom claim (platformAdmin == true).
    // Lockout-prevention bootstrap: Verified owner email (ahow0166@gmail.com) can bootstrap their /admins/{uid} record without lockout.
    // User-editable /users/{uid} documents and school_admin memberships NEVER grant platform administrator privileges.
    function isProvisionedPlatformAdmin() {
      return isVerified() && (
        ('platformAdmin' in request.auth.token && request.auth.token.platformAdmin == true) ||
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'active' &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'platform_admin'
        )
      );
    }

    function isBootstrapOwner() {
      return isVerified() && request.auth.token.email == 'ahow0166@gmail.com';
    }

    function isAdmin() {
      return isProvisionedPlatformAdmin() || isBootstrapOwner();
    }

    // Master Gate: Trusted School Authorization Helpers
    function isSchoolOwner(schoolId) {
      return isVerified() &&
        isValidId(schoolId) &&
        exists(/databases/$(database)/documents/schools/$(schoolId)) &&
        get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerId == request.auth.uid;
    }

    function hasActiveSchoolMembership(schoolId) {
      return isVerified() &&
        isValidId(schoolId) &&
        exists(/databases/$(database)/documents/school_memberships/$(schoolId + '_' + request.auth.uid)) &&
        get(/databases/$(database)/documents/school_memberships/$(schoolId + '_' + request.auth.uid)).data.status == 'active';
    }

    function hasSchoolRole(schoolId, roleName) {
      return hasActiveSchoolMembership(schoolId) &&
        get(/databases/$(database)/documents/school_memberships/$(schoolId + '_' + request.auth.uid)).data.role == roleName;
    }

    function isSchoolAdminFor(schoolId) {
      return isAdmin() || isSchoolOwner(schoolId) || hasSchoolRole(schoolId, 'school_admin');
    }

    function isSchoolTeacherFor(schoolId) {
      return isSchoolAdminFor(schoolId) || hasSchoolRole(schoolId, 'teacher');
    }

    function isSchoolStudentOrStaff(schoolId) {
      return isSchoolTeacherFor(schoolId) || hasSchoolRole(schoolId, 'student');
    }

    // Entity Blueprints (Anti-Update-Gap Validation Helpers)
    function isValidAdmin(data) {
      return data.keys().hasAll(['adminId', 'email', 'role', 'status', 'provisionedBy', 'provisioningMethod', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['adminId', 'email', 'role', 'status', 'provisionedBy', 'provisioningMethod', 'createdAt', 'updatedAt']) &&
        data.adminId is string && data.adminId.size() >= 1 && data.adminId.size() <= 128 && data.adminId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 256 &&
        data.role is string && data.role.size() <= 32 && data.role == 'platform_admin' &&
        data.status is string && data.status.size() <= 32 && (
          data.status == 'active' ||
          data.status == 'revoked'
        ) &&
        data.provisionedBy is string && data.provisionedBy.size() >= 1 && data.provisionedBy.size() <= 128 && data.provisionedBy.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.provisionedBy == request.auth.uid &&
        data.provisioningMethod is string && data.provisioningMethod.size() <= 32 && (
          data.provisioningMethod == 'bootstrap_owner_claim' ||
          data.provisioningMethod == 'admin_grant' ||
          data.provisioningMethod == 'server_custom_claim'
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'educationLevel', 'selectedClass', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'schoolId', 'educationLevel', 'selectedClass', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 256 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.role is string && data.role.size() <= 32 && (
          data.role == 'student' ||
          data.role == 'teacher' ||
          data.role == 'school_admin' ||
          data.role == 'independent_learner' ||
          data.role == 'platform_admin'
        ) &&
        (!('schoolId' in data) || (data.schoolId is string && data.schoolId.size() >= 1 && data.schoolId.size() <= 128)) &&
        data.educationLevel is string && data.educationLevel.size() <= 16 && (
          data.educationLevel == 'Primary' ||
          data.educationLevel == 'JSS' ||
          data.educationLevel == 'SSS'
        ) &&
        data.selectedClass is string && data.selectedClass.size() >= 1 && data.selectedClass.size() <= 32 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRolePermission(data) {
      return data.keys().hasAll(['roleId', 'title', 'description', 'createdAt']) &&
        data.keys().hasOnly(['roleId', 'title', 'description', 'createdAt']) &&
        data.roleId is string && data.roleId.size() >= 1 && data.roleId.size() <= 64 && data.roleId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 500 &&
        data.createdAt is timestamp;
    }

    function isValidSchool(data) {
      return data.keys().hasAll(['schoolId', 'name', 'state', 'lga', 'curriculumMode', 'activeSession', 'activeTerm', 'ownerId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['schoolId', 'name', 'state', 'lga', 'curriculumMode', 'activeSession', 'activeTerm', 'ownerId', 'createdAt', 'updatedAt']) &&
        data.schoolId is string && data.schoolId.size() >= 1 && data.schoolId.size() <= 128 && data.schoolId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 160 &&
        data.state is string && data.state.size() >= 2 && data.state.size() <= 64 &&
        data.lga is string && data.lga.size() >= 2 && data.lga.size() <= 100 &&
        data.curriculumMode is string && data.curriculumMode.size() <= 16 && (
          data.curriculumMode == 'built_in' ||
          data.curriculumMode == 'custom' ||
          data.curriculumMode == 'hybrid'
        ) &&
        data.activeSession is string && data.activeSession.size() >= 4 && data.activeSession.size() <= 32 &&
        data.activeTerm is string && data.activeTerm.size() <= 16 && (
          data.activeTerm == 'First Term' ||
          data.activeTerm == 'Second Term' ||
          data.activeTerm == 'Third Term'
        ) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSchoolMembership(data) {
      return data.keys().hasAll(['membershipId', 'schoolId', 'userId', 'role', 'status', 'authorizedBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['membershipId', 'schoolId', 'userId', 'role', 'status', 'authorizedBy', 'createdAt', 'updatedAt']) &&
        data.membershipId is string && data.membershipId.size() >= 3 && data.membershipId.size() <= 128 && data.membershipId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.schoolId is string && data.schoolId.size() >= 1 && data.schoolId.size() <= 128 && data.schoolId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.membershipId == data.schoolId + '_' + data.userId &&
        data.role is string && data.role.size() <= 32 && (
          data.role == 'student' ||
          data.role == 'teacher' ||
          data.role == 'school_admin'
        ) &&
        data.status is string && data.status.size() <= 32 && (
          data.status == 'active' ||
          data.status == 'invited' ||
          data.status == 'suspended'
        ) &&
        data.authorizedBy is string && data.authorizedBy.size() >= 1 && data.authorizedBy.size() <= 128 && data.authorizedBy.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorizedBy == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStudentProfile(data) {
      return data.keys().hasAll(['studentId', 'userId', 'schoolId', 'isIndependentLearner', 'educationLevel', 'currentClass', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['studentId', 'userId', 'schoolId', 'isIndependentLearner', 'educationLevel', 'currentClass', 'createdAt', 'updatedAt']) &&
        data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 && data.studentId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.schoolId is string && data.schoolId.size() >= 1 && data.schoolId.size() <= 128 &&
        data.isIndependentLearner is bool &&
        data.educationLevel is string && data.educationLevel.size() <= 16 && (
          data.educationLevel == 'Primary' ||
          data.educationLevel == 'JSS' ||
          data.educationLevel == 'SSS'
        ) &&
        data.currentClass is string && data.currentClass.size() >= 1 && data.currentClass.size() <= 32 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTeacherProfile(data) {
      return data.keys().hasAll(['teacherId', 'userId', 'schoolId', 'qualification', 'primarySubject', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['teacherId', 'userId', 'schoolId', 'qualification', 'primarySubject', 'createdAt', 'updatedAt']) &&
        data.teacherId is string && data.teacherId.size() >= 1 && data.teacherId.size() <= 128 && data.teacherId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.schoolId is string && data.schoolId.size() >= 1 && data.schoolId.size() <= 128 && data.schoolId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.qualification is string && data.qualification.size() >= 2 && data.qualification.size() <= 160 &&
        data.primarySubject is string && data.primarySubject.size() >= 2 && data.primarySubject.size() <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidClassArm(data) {
      return data.keys().hasAll(['classId', 'schoolId', 'educationLevel', 'className', 'armLabel', 'classTeacherId', 'studentCount', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['classId', 'schoolId', 'educationLevel', 'className', 'armLabel', 'classTeacherId', 'studentCount', 'createdAt', 'updatedAt']) &&
        data.classId is string && data.classId.size() >= 1 && data.classId.size() <= 128 && data.classId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.schoolId is string && data.schoolId.size() >= 1 && data.schoolId.size() <= 128 && data.schoolId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.educationLevel is string && data.educationLevel.size() <= 16 && (
          data.educationLevel == 'Primary' ||
          data.educationLevel == 'JSS' ||
          data.educationLevel == 'SSS'
        ) &&
        data.className is string && data.className.size() >= 1 && data.className.size() <= 32 &&
        data.armLabel is string && data.armLabel.size() >= 1 && data.armLabel.size() <= 64 &&
        data.classTeacherId is string && data.classTeacherId.size() >= 1 && data.classTeacherId.size() <= 128 && data.classTeacherId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.studentCount is int && data.studentCount >= 0 && data.studentCount <= 5000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAcademicSession(data) {
      return data.keys().hasAll(['sessionId', 'schoolId', 'name', 'startDate', 'endDate', 'isCurrent', 'ownerId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['sessionId', 'schoolId', 'name', 'startDate', 'endDate', 'isCurrent', 'ownerId', 'createdAt', 'updatedAt']) &&
        data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128 && data.sessionId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.schoolId is string && data.schoolId.size() >= 1 && data.schoolId.size() <= 128 && data.schoolId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 4 && data.name.size() <= 64 &&
        data.startDate is string && data.startDate.size() >= 4 && data.startDate.size() <= 32 &&
        data.endDate is string && data.endDate.size() >= 4 && data.endDate.size() <= 32 &&
        data.isCurrent is bool &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTerm(data) {
      return data.keys().hasAll(['termId', 'sessionId', 'schoolId', 'name', 'weeksCount', 'isCurrent', 'ownerId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['termId', 'sessionId', 'schoolId', 'name', 'weeksCount', 'isCurrent', 'ownerId', 'createdAt', 'updatedAt']) &&
        data.termId is string && data.termId.size() >= 1 && data.termId.size() <= 128 && data.termId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128 && data.sessionId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.schoolId is string && data.schoolId.size() >= 1 && data.schoolId.size() <= 128 && data.schoolId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() <= 16 && (
          data.name == 'First Term' ||
          data.name == 'Second Term' ||
          data.name == 'Third Term'
        ) &&
        data.weeksCount is int && data.weeksCount >= 1 && data.weeksCount <= 20 &&
        data.isCurrent is bool &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCurriculum(data) {
      return data.keys().hasAll(['curriculumId', 'name', 'country', 'source', 'version', 'academicPeriod', 'educationLevel', 'className', 'schoolId', 'isPlatformWide', 'approvalStatus', 'ownerId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['curriculumId', 'name', 'country', 'source', 'version', 'academicPeriod', 'educationLevel', 'className', 'schoolId', 'isPlatformWide', 'approvalStatus', 'ownerId', 'createdAt', 'updatedAt']) &&
        data.curriculumId is string && data.curriculumId.size() >= 1 && data.curriculumId.size() <= 128 && data.curriculumId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 160 &&
        data.country is string && data.country.size() >= 2 && data.country.size() <= 64 &&
        data.source is string && data.source.size() >= 2 && data.source.size() <= 200 &&
        data.version is string && data.version.size() >= 1 && data.version.size() <= 32 &&
        data.academicPeriod is string && data.academicPeriod.size() >= 4 && data.academicPeriod.size() <= 32 &&
        data.educationLevel is string && data.educationLevel.size() <= 16 && (
          data.educationLevel == 'Primary' ||
          data.educationLevel == 'JSS' ||
          data.educationLevel == 'SSS'
        ) &&
        data.className is string && data.className.size() >= 1 && data.className.size() <= 32 &&
        data.schoolId is string && data.schoolId.size() >= 1 && data.schoolId.size() <= 128 &&
        data.isPlatformWide is bool &&
        data.approvalStatus is string && data.approvalStatus.size() <= 32 && (
          data.approvalStatus == 'draft' ||
          data.approvalStatus == 'pending_review' ||
          data.approvalStatus == 'approved' ||
          data.approvalStatus == 'sample_unverified'
        ) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCurriculumVersion(data) {
      return data.keys().hasAll(['versionId', 'curriculumId', 'schoolId', 'isPlatformWide', 'versionNumber', 'changelog', 'approvalStatus', 'createdBy', 'createdAt']) &&
        data.keys().hasOnly(['versionId', 'curriculumId', 'schoolId', 'isPlatformWide', 'versionNumber', 'changelog', 'approvalStatus', 'createdBy', 'createdAt']) &&
        data.versionId is string && data.versionId.size() >= 1 && data.versionId.size() <= 128 && data.versionId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.curriculumId is string && data.curriculumId.size() >= 1 && data.curriculumId.size() <= 128 && data.curriculumId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.schoolId is string && data.schoolId.size() >= 1 && data.schoolId.size() <= 128 &&
        data.isPlatformWide is bool &&
        data.versionNumber is string && data.versionNumber.size() >= 1 && data.versionNumber.size() <= 32 &&
        data.changelog is string && data.changelog.size() >= 2 && data.changelog.size() <= 1000 &&
        data.approvalStatus is string && data.approvalStatus.size() <= 32 && (
          data.approvalStatus == 'draft' ||
          data.approvalStatus == 'pending_review' ||
          data.approvalStatus == 'approved' ||
          data.approvalStatus == 'sample_unverified'
        ) &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 && data.createdBy.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdBy == request.auth.uid &&
        data.createdAt is timestamp;
    }

    function isValidSubject(data) {
      return data.keys().hasAll(['subjectId', 'curriculumId', 'schoolId', 'isPlatformWide', 'educationLevel', 'className', 'name', 'category', 'isCompulsory', 'ownerId', 'createdAt']) &&
        data.keys().hasOnly(['subjectId', 'curriculumId', 'schoolId', 'isPlatformWide', 'educationLevel', 'className', 'name', 'category', 'isCompulsory', 'ownerId', 'createdAt']) &&
        data.subjectId is string && data.subjectId.size() >= 1 && data.subjectId.size() <= 128 && data.subjectId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.curriculumId is string && data.curriculumId.size() >= 1 && data.curriculumId.size() <= 128 && data.curriculumId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.schoolId is string && data.schoolId.size() >= 1 && data.schoolId.size() <= 128 &&
        data.isPlatformWide is bool &&
        data.educationLevel is string && data.educationLevel.size() <= 16 && (
          data.educationLevel == 'Primary' ||
          data.educationLevel == 'JSS' ||
          data.educationLevel == 'SSS'
        ) &&
        data.className is string && data.className.size() >= 1 && data.className.size() <= 32 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.category is string && data.category.size() <= 32 && (
          data.category == 'Core' ||
          data.category == 'Science' ||
          data.category == 'Humanities' ||
          data.category == 'Business & Vocational' ||
          data.category == 'School Custom'
        ) &&
        data.isCompulsory is bool &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.createdAt is timestamp;
    }

    function isValidTopic(data) {
      return data.keys().hasAll(['topicId', 'curriculumId', 'educationLevel', 'className', 'subject', 'term', 'weekNumber', 'title', 'learningObjective', 'lessonSummary', 'assessmentPrompt', 'skillTag', 'schoolId', 'isPlatformWide', 'approvalStatus', 'ownerId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['topicId', 'curriculumId', 'educationLevel', 'className', 'subject', 'term', 'weekNumber', 'title', 'learningObjective', 'lessonSummary', 'assessmentPrompt', 'skillTag', 'schoolId', 'isPlatformWide', 'approvalStatus', 'ownerId', 'createdAt', 'updatedAt']) &&
        data.topicId is string && data.topicId.size() >= 1 && data.topicId.size() <= 128 && data.topicId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.curriculumId is string && data.curriculumId.size() >= 1 && data.curriculumId.size() <= 128 && data.curriculumId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.educationLevel is string && data.educationLevel.size() <= 16 && (
          data.educationLevel == 'Primary' ||
          data.educationLevel == 'JSS' ||
          data.educationLevel == 'SSS'
        ) &&
        data.className is string && data.className.size() >= 1 && data.className.size() <= 32 &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 100 &&
        data.term is string && data.term.size() <= 16 && (
          data.term == 'First Term' ||
          data.term == 'Second Term' ||
          data.term == 'Third Term'
        ) &&
        data.weekNumber is int && data.weekNumber >= 1 && data.weekNumber <= 14 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 200 &&
        data.learningObjective is string && data.learningObjective.size() >= 5 && data.learningObjective.size() <= 600 &&
        data.lessonSummary is string && data.lessonSummary.size() >= 5 && data.lessonSummary.size() <= 2000 &&
        data.assessmentPrompt is string && data.assessmentPrompt.size() >= 5 && data.assessmentPrompt.size() <= 600 &&
        data.skillTag is string && data.skillTag.size() >= 2 && data.skillTag.size() <= 120 &&
        data.schoolId is string && data.schoolId.size() >= 1 && data.schoolId.size() <= 128 &&
        data.isPlatformWide is bool &&
        data.approvalStatus is string && data.approvalStatus.size() <= 32 && (
          data.approvalStatus == 'draft' ||
          data.approvalStatus == 'pending_review' ||
          data.approvalStatus == 'approved' ||
          data.approvalStatus == 'sample_unverified'
        ) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLearningObjective(data) {
      return data.keys().hasAll(['objectiveId', 'topicId', 'schoolId', 'isPlatformWide', 'description', 'bloomTaxonomyLevel', 'measurableCriteria', 'ownerId', 'createdAt']) &&
        data.keys().hasOnly(['objectiveId', 'topicId', 'schoolId', 'isPlatformWide', 'description', 'bloomTaxonomyLevel', 'measurableCriteria', 'ownerId', 'createdAt']) &&
        data.objectiveId is string && data.objectiveId.size() >= 1 && data.objectiveId.size() <= 128 && data.objectiveId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.topicId is string && data.topicId.size() >= 1 && data.topicId.size() <= 128 && data.topicId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.schoolId is string && data.schoolId.size() >= 1 && data.schoolId.size() <= 128 &&
        data.isPlatformWide is bool &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 600 &&
        data.bloomTaxonomyLevel is string && data.bloomTaxonomyLevel.size() <= 32 && (
          data.bloomTaxonomyLevel == 'Remember' ||
          data.bloomTaxonomyLevel == 'Understand' ||
          data.bloomTaxonomyLevel == 'Apply' ||
          data.bloomTaxonomyLevel == 'Analyze' ||
          data.bloomTaxonomyLevel == 'Evaluate' ||
          data.bloomTaxonomyLevel == 'Create'
        ) &&
        data.measurableCriteria is string && data.measurableCriteria.size() >= 5 && data.measurableCriteria.size() <= 600 &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.createdAt is timestamp;
    }

