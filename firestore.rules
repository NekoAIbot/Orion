        existing().reviewedBy == request.auth.uid
      );
      allow create: if isVerified() && isValidId(approvalId) && isValidApprovalRecord(incoming()) &&
        incoming().approvalId == approvalId &&
        isSchoolAdminFor(incoming().schoolId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(approvalId) && isValidApprovalRecord(incoming()) && (
        isAdmin() || (
          isSchoolAdminFor(existing().schoolId) &&
          incoming().approvalId == existing().approvalId &&
          incoming().schoolId == existing().schoolId &&
          incoming().targetId == existing().targetId &&
          incoming().submittedBy == existing().submittedBy &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewerComment', 'reviewedBy', 'updatedAt'])
        )
      );
      allow delete: if isAdmin() && isValidId(approvalId);
    }

    // 27. Student Projects Collection
    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && (
        existing().studentId == request.auth.uid ||
        ('schoolId' in existing() && existing().schoolId != 'independent' && isSchoolTeacherFor(existing().schoolId)) ||
        isAdmin()
      );
      allow list: if isSignedIn() && existing().studentId == request.auth.uid;
      allow create: if isVerified() && isValidId(projectId) && isValidStudentProject(incoming()) &&
        incoming().projectId == projectId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(projectId) && isValidStudentProject(incoming()) && (
        isAdmin() || (
          existing().studentId == request.auth.uid &&
          incoming().projectId == existing().projectId &&
          incoming().studentId == existing().studentId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['reflectionNotes', 'status', 'updatedAt'])
        )
      );
      allow delete: if isAdmin() && isValidId(projectId);
    }

    // 28. Learning Achievements Collection
    match /achievements/{achievementId} {
      allow get: if isSignedIn() && isValidId(achievementId) && (
        existing().studentId == request.auth.uid ||
        ('schoolId' in existing() && existing().schoolId != 'independent' && isSchoolTeacherFor(existing().schoolId)) ||
        isAdmin()
      );
      allow list: if isSignedIn() && existing().studentId == request.auth.uid;
      allow create: if isVerified() && isValidId(achievementId) && isValidLearningAchievement(incoming()) &&
        incoming().achievementId == achievementId &&
        incoming().createdAt == request.time;
      allow update, delete: if isAdmin() && isValidId(achievementId);
    }
  }
}
